# Use hoisted node_modules layout so Bun runtime can resolve packages
# (Bun doesn't support pnpm's default symlink-based layout)
node-linker=hoisted

# Don't auto-install peer dependencies (bun is provided by asdf, not npm)
auto-install-peers=false

# Enable pnpm deploy for isolated Docker builds (v10 requirement)
force-legacy-deploy=true
