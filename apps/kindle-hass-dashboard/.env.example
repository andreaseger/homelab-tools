# Home Assistant
HASS_URL=http://home-assistant.home-assistant.svc:8123
HASS_TOKEN=your_long_lived_access_token_here

# Auth
DASHBOARD_TOKEN=your_dashboard_bearer_token_here

# Server
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
RENDER_DEBOUNCE_MS=500

# M7 Matterbridge (optional)
EXPOSE_ENABLED=false
KINDLE_DASH_URL=http://127.0.0.1:8080
MATTERBRIDGE_DIR=/root/.matterbridge
