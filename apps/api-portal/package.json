{
  "name": "api-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "js-yaml": "^4.1.0",
    "react": "^18",
    "react-dom": "^18",
    "swagger-editor": "5.3.0",
    "swagger-ui-react": "5.32.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/swagger-ui-react": "^5.18.0",
    "bun-types": "^1.3.10",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "dev": "SPECS_DIR=../../specs/ bun --hot server/index.ts",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build --build-arg PNPM_VERSION=$(awk '$1==\"pnpm\"{print $2}' ../../.tool-versions) --build-arg NODE_VERSION=$(awk '$1==\"node\"{print $2}' ../../.tool-versions) --build-arg BUN_VERSION=$(awk '$1==\"bun\"{print $2}' ../../.tool-versions) -t api-portal ."
  },
  "docker": {
    "platforms": "linux/amd64,linux/arm64"
  }
}
